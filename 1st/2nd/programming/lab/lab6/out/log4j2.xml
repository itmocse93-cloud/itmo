<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%-10c] %-7p %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="Server"     level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="Connection" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="Command"    level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="Error"      level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>